# Notion token: a personal access token or internal integration secret
# (https://www.notion.so/profile/integrations)
NOTION_API_KEY=

# Student OS core databases (from the "Build Your Student OS" guide).
# Share each database with your integration, then paste its ID from the Notion URL.
# Courses and Assignments are required; the rest are optional.
NOTION_COURSES_DB_ID=
NOTION_ASSIGNMENTS_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_NOTES_DB_ID=
NOTION_EXAMS_DB_ID=
